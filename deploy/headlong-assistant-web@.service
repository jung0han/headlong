# Continuous Registered Web Source bridge for one Observer Identity.

[Unit]
Description=headlong Web Source bridge for Observer Identity %i
After=network-online.target
Wants=network-online.target
PartOf=headlong-assistant@%i.target
OnFailure=headlong-assistant-alert@web-%i.service

[Service]
Type=simple
User=shellm
WorkingDirectory=@SHELLM_HOME@/app
Environment="PATH=@SHELLM_HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-/etc/headlong/assistant.env
Environment="HEADLONG_ARCHIVE_SOCKET=/run/headlong-archive/archive.sock"
ExecStart=/bin/bash @SHELLM_HOME@/app/deploy/assistant-service.sh @SHELLM_HOME@/app %i web
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=@SHELLM_HOME@/app/.identities/%i @SHELLM_HOME@/app/.assistant-authority @SHELLM_HOME@/app/.assistant-observers
ReadOnlyPaths=@CODEX_HOME@

[Install]
WantedBy=headlong-assistant@%i.target
