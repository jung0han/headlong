# headlong-web systemd unit. Installed by deploy/setup.sh, which substitutes
# @SHELLM_HOME@ (default /opt/shellm; the repo lives at @SHELLM_HOME@/app).
#
# deploy/update.sh re-syncs this file on every deploy — do NOT hand-edit the
# installed copy; put box-local changes in a drop-in that survives deploys:
#   /etc/systemd/system/headlong-web.service.d/override.conf
#   ([Service] + Environment=... lines; then daemon-reload + restart)
#
# The web server binds 127.0.0.1 only — expose it exclusively through the
# Cloudflare tunnel (see deploy/DEPLOY.md). Dispatchers started from the UI
# run as headlong-thinkers@<identity> units (via HEADLONG_THINKERSCTL below), so
# they live in their own cgroup and survive restarts of this service.

[Unit]
Description=headlong web viewer + control plane
After=network-online.target headlong-archive.service
Wants=network-online.target headlong-archive.service

[Service]
Type=simple
User=shellm
WorkingDirectory=@SHELLM_HOME@/app
Environment="PATH=@SHELLM_HOME@/.local/bin:@SHELLM_HOME@/.bun/bin:/usr/local/bin:/usr/bin:/bin"
# Lock CORS to your public hostname once the tunnel is up:
#Environment="HEADLONG_WEB_ALLOWED_ORIGINS=https://agents.example.com"
# For a view-only deployment (no start/stop/chat/config mutations):
#Environment="HEADLONG_WEB_READONLY=1"
# The dash's build-stamp menu can pull the repo and restart the service
# (safe here because Restart=always brings it back). Remove to disable.
Environment="HEADLONG_WEB_SELF_UPDATE=1"
# Dispatcher lifecycle goes through per-identity systemd units via this
# root-owned wrapper (sudo rule: /etc/sudoers.d/headlong-thinkers). Unset it
# to fall back to spawning dispatchers directly (dev behavior).
Environment="HEADLONG_THINKERSCTL=/usr/local/bin/headlong-thinkersctl"
Environment="HEADLONG_ARCHIVE_SOCKET=/run/headlong-archive/archive.sock"
ExecStart=@SHELLM_HOME@/app/tools/headlong-web @SHELLM_HOME@/app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3
# Cap the trajectory-cache balloon (2026-08-13: repeated 5-6GB RSS OOM
# kills, and the final thrash episode took the whole box off the network
# for 13h). Inside the cap the kernel kills only this cgroup, early, and
# Restart=always brings the service back — global memory pressure never
# builds. 5G, not lower: one parse of audel's mind log is ~3.5G today
# (~6x the on-disk jsonl), so a tighter cap would kill-loop the dash.
# KillMode=process does not affect this: the kernel's cgroup OOM kill
# picks the biggest task in the cgroup (the python server), uv exits with
# it, and systemd restarts. Real fix: bound the cache itself.
MemoryMax=5G
# Signal only the main process on stop/restart. Dispatchers now run in
# their own headlong-thinkers@ units, but short-lived CLI mutations (chat,
# named thinker kicks) and agent-spawned background jobs can still be in
# this cgroup, and the default KillMode=control-group would kill them on
# any restart (including the dash's self-update). Agents have their own
# kill switches: the UI's Kill All button and tools/headlong-killall.
KillMode=process
ReadOnlyPaths=@CODEX_HOME@

# The agent needs broad shell access by design — do NOT run anything else on
# this machine. Kill switches: `systemctl stop headlong-web` stops the control
# plane; `@SHELLM_HOME@/app/tools/headlong-killall` stops all agent processes.

[Install]
WantedBy=multi-user.target
