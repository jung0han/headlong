#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
if [[ ! -d "$REPO_ROOT/web" ]]; then
    _home="${HEADLONG_HOME:-${SHELLM_HOME:-$HOME/.headlong}}"
    _recorded=$(cat "$_home/app_dir" 2>/dev/null || true)
    if [[ -n "$_recorded" && -d "$_recorded/web" ]]; then REPO_ROOT="$_recorded"
    elif [[ -d "$_home/app/web" ]]; then REPO_ROOT="$_home/app"
    else echo "headlong-archive-boundary: can't find the HeadLong checkout" >&2; exit 1
    fi
fi
command -v uv >/dev/null 2>&1 || { echo "headlong-archive-boundary: uv is required" >&2; exit 1; }
exec uv run --project "$REPO_ROOT/web" headlong-archive-boundary "$@"
