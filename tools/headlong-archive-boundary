#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
if [[ ! -d "$REPO_ROOT/web" ]]; then
    if [[ -n "${HEADLONG_HOME:-}" ]]; then
        _state_home="$HEADLONG_HOME"
    elif [[ -n "${SHELLM_HOME:-}" ]]; then
        _state_home="$SHELLM_HOME"
    elif [[ -e "$HOME/.headlong" || ! -e "$HOME/.shellm" ]]; then
        _state_home="$HOME/.headlong"
    else
        _state_home="$HOME/.shellm"
    fi
    _recorded=$(cat "$_state_home/app_dir" 2>/dev/null || true)
    if [[ -n "$_recorded" && -d "$_recorded/web" ]]; then REPO_ROOT="$_recorded"
    elif [[ -d "$_state_home/app/web" ]]; then REPO_ROOT="$_state_home/app"
    else echo "headlong-archive-boundary: can't find the HeadLong checkout" >&2; exit 1
    fi
fi
if [[ -x "$REPO_ROOT/web/.venv/bin/headlong-archive-boundary" ]]; then
    exec "$REPO_ROOT/web/.venv/bin/headlong-archive-boundary" "$@"
fi
command -v uv >/dev/null 2>&1 || { echo "headlong-archive-boundary: uv is required" >&2; exit 1; }
exec uv run --project "$REPO_ROOT/web" headlong-archive-boundary "$@"
