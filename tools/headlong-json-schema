#!/usr/bin/env python3
"""Validate one bounded JSON value against HeadLong's local schema subset."""

from __future__ import annotations

import json
import sys
from typing import Any

MAX_RESULT_BYTES = 64_000


def _matches_type(value: Any, expected: str) -> bool:
    return {
        "object": isinstance(value, dict),
        "array": isinstance(value, list),
        "string": isinstance(value, str),
        "integer": isinstance(value, int) and not isinstance(value, bool),
        "number": isinstance(value, (int, float)) and not isinstance(value, bool),
        "boolean": isinstance(value, bool),
        "null": value is None,
    }.get(expected, False)


def _validate(value: Any, schema: dict[str, Any], path: str = "$") -> None:
    expected = schema.get("type")
    if expected is not None:
        choices = expected if isinstance(expected, list) else [expected]
        if not any(_matches_type(value, choice) for choice in choices):
            raise ValueError(f"{path} has the wrong type")
    if "enum" in schema and value not in schema["enum"]:
        raise ValueError(f"{path} is not an allowed value")
    if isinstance(value, str):
        if len(value) < schema.get("minLength", 0):
            raise ValueError(f"{path} is too short")
        if len(value) > schema.get("maxLength", len(value)):
            raise ValueError(f"{path} is too long")
    if isinstance(value, list):
        if len(value) < schema.get("minItems", 0):
            raise ValueError(f"{path} has too few items")
        if len(value) > schema.get("maxItems", len(value)):
            raise ValueError(f"{path} has too many items")
        item_schema = schema.get("items")
        if isinstance(item_schema, dict):
            for index, item in enumerate(value):
                _validate(item, item_schema, f"{path}[{index}]")
    if isinstance(value, dict):
        properties = schema.get("properties", {})
        missing = [name for name in schema.get("required", []) if name not in value]
        if missing:
            raise ValueError(f"{path} is missing {missing[0]}")
        if schema.get("additionalProperties") is False:
            unknown = set(value) - set(properties)
            if unknown:
                raise ValueError(f"{path} has unknown field {sorted(unknown)[0]}")
        for name, child_schema in properties.items():
            if name in value:
                _validate(value[name], child_schema, f"{path}.{name}")


def main() -> int:
    if sys.argv[1:] == ["--help"]:
        print("usage: headlong-json-schema SCHEMA_FILE")
        return 0
    if len(sys.argv) != 2:
        print("usage: headlong-json-schema SCHEMA_FILE", file=sys.stderr)
        return 2
    raw = sys.stdin.buffer.read(MAX_RESULT_BYTES + 1)
    if not raw or len(raw) > MAX_RESULT_BYTES:
        print("structured result is empty or oversized", file=sys.stderr)
        return 2
    try:
        schema = json.loads(open(sys.argv[1], encoding="utf-8").read())
        value = json.loads(raw)
        if not isinstance(schema, dict):
            raise ValueError("schema is not an object")
        _validate(value, schema)
    except (OSError, json.JSONDecodeError, ValueError) as exc:
        print(f"structured result did not match schema: {exc}", file=sys.stderr)
        return 2
    print(json.dumps(value, ensure_ascii=False, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
